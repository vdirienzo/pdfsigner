{
  "name": "with_qr",
  "description": "Signature stamp with QR verification code",
  "width_mm": 70,
  "height_mm": 25,
  "layers": [
    {
      "type": "background",
      "color": "#ffffff"
    },
    {
      "type": "border",
      "color": "#333333",
      "border_width": 1
    },
    {
      "type": "qr",
      "x": 3,
      "y": 10,
      "width": 25,
      "height": 80
    },
    {
      "type": "text",
      "x": 32,
      "y": 12,
      "text": "{signer_name}",
      "font_size": 10,
      "color": "#000000",
      "font_family": "sans-serif"
    },
    {
      "type": "text",
      "x": 32,
      "y": 45,
      "text": "{date}",
      "font_size": 8,
      "color": "#666666",
      "font_family": "sans-serif"
    },
    {
      "type": "text",
      "x": 32,
      "y": 72,
      "text": "Verifiable",
      "font_size": 7,
      "color": "#888888",
      "font_family": "sans-serif"
    }
  ]
}
