msgstr "Configuración para el cumplimiento de la ley de firma digital argentina. Permite validar certificados de certificadores licenciados."

msgid "Enable Argentine compliance"
msgstr "Habilitar cumplimiento argentino"

msgid "Validate certificates against licensed certifiers (AFIP, RENAPER, etc.)"
msgstr "Validar certificados contra certificadores licenciados (AFIP, RENAPER, etc.)"

msgid "Activate validation for Argentine licensed certifiers"
msgstr "Activar validación para certificadores licenciados argentinos"

msgid "Strict mode"
msgstr "Modo estricto"

msgid "Only accept certificates from licensed Argentine certifiers"
msgstr "Aceptar solo certificados de certificadores argentinos licenciados"

msgid "Reject certificates not issued by licensed Argentine certifiers"
msgstr "Rechazar certificados no emitidos por certificadores argentinos licenciados"

msgid "Governmental Certifiers (Free)"
msgstr "Certificadores Gubernamentales (Gratuitos)"

