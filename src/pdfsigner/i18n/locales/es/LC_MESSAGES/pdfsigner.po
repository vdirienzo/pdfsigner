msgid "Remote signature with HSM - Free for citizens"
msgstr "Firma remota con HSM - Gratuito para ciudadanos"

msgid "FDR website"
msgstr "Sitio web de FDR"

msgid "Visit FDR website for remote signature service"
msgstr "Visite el sitio web de FDR para el servicio de firma remota"

msgid "Social security works - Token - Free"
msgstr "Obras sociales - Token - Gratuito"

msgid "Private Certifiers"
msgstr "Certificadores Privados"

