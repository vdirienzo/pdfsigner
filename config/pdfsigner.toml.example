# PDFSigner - Configuration
#
# Author: Homero Thompson del Lago del Terror
#
# Copy to ~/.config/pdfsigner/config.toml and adjust values.

# ═══════════════════════════════════════════════════════════════
# NSS Database
# ═══════════════════════════════════════════════════════════════
# Path to NSS database where USB token is configured
nss_db_path = "/home/user/.nss"

# ═══════════════════════════════════════════════════════════════
# Timestamp Authority (TSA) - REQUIRED for PAdES-LTV
# ═══════════════════════════════════════════════════════════════
#
# TSA (Timestamp Authority) provides cryptographic proof of the
# signature date/time. Without TSA, signature is PAdES-B (basic).
#
# ┌─────────────────────────────────────────────────────────────┐
# │  OPTION 1: Free Public TSAs (recommended)                    │
# └─────────────────────────────────────────────────────────────┘
# Legally valid, no cost, no authentication.
#
# FreeTSA (recommended):
tsa_url = "https://freetsa.org/tsr"
#
# Free alternatives:
#   tsa_url = "http://timestamp.digicert.com"
#   tsa_url = "http://timestamp.sectigo.com"
#   tsa_url = "http://timestamp.globalsign.com/tsa/r6advanced1"
#   tsa_url = "http://tsa.starfieldtech.com"
#
# ┌─────────────────────────────────────────────────────────────┐
# │  OPTION 2: Corporate/Local TSA                               │
# └─────────────────────────────────────────────────────────────┘
# If your organization has its own TSA server.
#
# Corporate TSA example:
#   tsa_url = "https://tsa.mycompany.com/timestamp"
#   tsa_username = "username"
#   tsa_password = "password"
#
# Local TSA example (for development/testing):
#   tsa_url = "http://localhost:8080/timestamp"
#
# ┌─────────────────────────────────────────────────────────────┐
# │  OPTION 3: Certificate provider's TSA                        │
# └─────────────────────────────────────────────────────────────┘
# Many CAs (Certificate Authorities) offer TSA included
# with certificate purchase. Check your CA's documentation.
#
# Examples by country/provider:
#   Argentina (AFIP): "https://tsaserver.afip.gob.ar/tsa/tss"
#   Spain (FNMT): "https://www.fnmt.es/tsa/tss"
#
# ┌─────────────────────────────────────────────────────────────┐
# │  OPTION 4: Without TSA (basic PAdES-B)                       │
# └─────────────────────────────────────────────────────────────┘
# Leave empty for signature without timestamp. Signature is valid but
# has no proof of when it was created.
#
#   tsa_url = ""
#
# ───────────────────────────────────────────────────────────────

# TSA credentials (only if your TSA requires authentication)
# tsa_username = ""
# tsa_password = ""

# ═══════════════════════════════════════════════════════════════
# Visible Signature (optional)
# ═══════════════════════════════════════════════════════════════
# If signature is visible by default
default_visible = false

# Signature stamp dimensions (in millimeters)
signature_width_mm = 50
signature_height_mm = 20

# Custom image for visible signature (PNG or JPG)
# signature_image_path = "/path/to/my_signature.png"

# Default page for visible signature: "last", "first", or number
default_page = "last"

# ═══════════════════════════════════════════════════════════════
# Output
# ═══════════════════════════════════════════════════════════════
# Suffix for signed files
# Example: document.pdf → document_signed.pdf
output_suffix = "_signed"

# ═══════════════════════════════════════════════════════════════
# PIN Cache
# ═══════════════════════════════════════════════════════════════
# Cache PIN during batch signing (more convenient but less secure)
pin_cache_enabled = true

# Cache expiration time in seconds (5 minutes by default)
pin_cache_timeout_seconds = 300

# ═══════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════
# Log level: DEBUG, INFO, WARNING, ERROR
log_level = "INFO"

# Logs directory
# log_dir = "~/.local/share/pdfsigner/logs"

# ═══════════════════════════════════════════════════════════════
# Nautilus Integration
# ═══════════════════════════════════════════════════════════════
# Configure behavior when right-clicking PDFs in Nautilus
#
# Mode: "gui" or "quick"
#   - gui:   Opens the full PDFSigner application (default)
#   - quick: Signs directly with preconfigured options (only asks for PIN)
#
nautilus_mode = "gui"

# ┌─────────────────────────────────────────────────────────────┐
# │  Quick Mode Settings (only used when nautilus_mode = "quick") │
# └─────────────────────────────────────────────────────────────┘
#
# Add visible stamp to signed documents
nautilus_visible_stamp = false

# Stamp position (only if nautilus_visible_stamp = true)
# Options: "bottom_right", "bottom_left", "top_right", "top_left",
#          "bottom_center", "top_center"
nautilus_stamp_position = "bottom_right"

# Page for stamp: "last", "first", or "all"
nautilus_stamp_page = "last"

# Show signer name in stamp (from certificate CN)
nautilus_show_name = true

# Show signature date in stamp
nautilus_show_date = true

# ┌─────────────────────────────────────────────────────────────┐
# │  Quick Mode Examples                                         │
# └─────────────────────────────────────────────────────────────┘
#
# Example 1: Invisible signature (fastest)
#   nautilus_mode = "quick"
#   nautilus_visible_stamp = false
#
# Example 2: Visible signature bottom-right
#   nautilus_mode = "quick"
#   nautilus_visible_stamp = true
#   nautilus_stamp_position = "bottom_right"
#   nautilus_stamp_page = "last"
#
# Example 3: Always open GUI for full control
#   nautilus_mode = "gui"

# ═══════════════════════════════════════════════════════════════
# Dry Run Mode (Development/Testing)
# ═══════════════════════════════════════════════════════════════
# Enable to test without real USB token
# dry_run = false
