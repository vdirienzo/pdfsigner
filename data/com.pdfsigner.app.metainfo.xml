<component type="desktop-application">
  <id>com.pdfsigner.app</id>
  <name>PDFSigner</name>
  <summary>Sign PDF documents with USB cryptographic tokens</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="com.github.vdirienzo">
    <name>Homero Thompson del Lago del Terror</name>
  </developer>

  <description>
    <p>PDFSigner is a GTK4 application for digitally signing PDF documents
    using USB cryptographic tokens (PKCS#11). Features include:</p>
    <ul>
      <li>PAdES-LTV signatures with TSA timestamp</li>
      <li>Support for multiple token types (SafeNet, YubiKey, Nitrokey, OpenSC)</li>
      <li>Batch signing with PIN cache</li>
      <li>Visible signature stamps with smart positioning</li>
      <li>Signature validation</li>
      <li>Dry-run mode for testing without real token</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.pdfsigner.app.desktop</launchable>

